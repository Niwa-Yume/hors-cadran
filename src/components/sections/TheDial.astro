---
import { CATEGORIES } from '../../data/products';
import { BRAND_NAME } from '../../data/brand';

const initials = BRAND_NAME.split(/\s+/).map((w) => w[0]).join('');

const C = 320;
const ticks = Array.from({ length: 60 }, (_, i) => {
  const a = (i * 6 * Math.PI) / 180;
  const major = i % 5 === 0;
  const r1 = 304;
  const r2 = major ? 278 : 292;
  return {
    x1: C + Math.sin(a) * r1,
    y1: C - Math.cos(a) * r1,
    x2: C + Math.sin(a) * r2,
    y2: C - Math.cos(a) * r2,
    major,
  };
});
// Odd hours carry tiny mono numerals (minutes, as on a sector dial).
const numerals = [1, 3, 5, 7, 9, 11].map((h) => {
  const a = (h * 30 * Math.PI) / 180;
  return { x: C + Math.sin(a) * 258, y: C - Math.cos(a) * 258 + 4, label: String(h * 5).padStart(2, '0') };
});
const labels = CATEGORIES.map((cat, i) => {
  const deg = i * 60;
  const a = (deg * Math.PI) / 180;
  const words = cat.label.split(' ');
  const lines = words.length > 2 ? [words.slice(0, 2).join(' '), words.slice(2).join(' ')] : [cat.label];
  return { ...cat, deg, left: 50 + Math.sin(a) * 33, top: 50 - Math.cos(a) * 33, lines };
});
---

<section class="dial-section" id="categories" aria-labelledby="dial-title">
  <header class="dial-head">
    <p class="mono dial-kicker">Six complications</p>
    <h2 id="dial-title" class="display dial-title" data-split>Pick a complication</h2>
  </header>

  <div class="dial" data-dial>
    <svg class="dial__face" viewBox="0 0 640 640" aria-hidden="true">
      <circle cx="320" cy="320" r="318" fill="#fff" />
      <circle cx="320" cy="320" r="318" fill="var(--dial-tint, transparent)" opacity="0.12" class="dial__tint" />
      <circle cx="320" cy="320" r="317" fill="none" stroke="rgba(17,17,17,.15)" />
      <circle cx="320" cy="320" r="304" fill="none" stroke="rgba(17,17,17,.2)" stroke-width="1" />
      {ticks.map((t) => (
        <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke="#111" stroke-width={t.major ? 3 : 1.2} />
      ))}
      {numerals.map((n) => (
        <text x={n.x} y={n.y} text-anchor="middle" class="dial__num">{n.label}</text>
      ))}
    </svg>
    <svg class="dial__hand-layer" viewBox="0 0 640 640" aria-hidden="true">
      <g class="dial__hand" data-dial-hand>
        <line x1="320" y1="372" x2="320" y2="66" stroke="#111" stroke-width="3" stroke-linecap="round" />
        <rect x="317" y="56" width="6" height="56" rx="3" class="dial__tip" />
        <circle cx="320" cy="372" r="9" fill="#111" />
      </g>
    </svg>

    <div class="dial__disc" data-dial-disc aria-live="polite">
      <img class="dial__thumb" data-dial-thumb src="" alt="" width="200" height="200" hidden />
      <span class="gothic dial__mark" data-dial-mark>{initials}</span>
      <span class="mono dial__count" data-dial-count>06 CATEGORIES</span>
    </div>

    {
      labels.map((l) => (
        <button
          type="button"
          class="display dial__label"
          style={`left:${l.left}%;top:${l.top}%;--accent:${l.accent}`}
          data-dial-label={l.id}
          data-deg={l.deg}
          data-accent={l.accent}
        >
          {l.lines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </button>
      ))
    }
  </div>

  <ul class="dial-pills edge-fade" aria-label="Categories">
    {
      CATEGORIES.map((cat) => (
        <li>
          <button type="button" class="pill pill--sm" style={`--accent:${cat.accent}`} data-dial-pill={cat.id}>
            <span>{cat.label}</span>
          </button>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .dial-section {
    background: var(--color-paper);
    padding: clamp(80px, 12vw, 160px) 16px clamp(64px, 9vw, 120px);
    display: grid;
    justify-items: center;
    gap: clamp(32px, 5vw, 64px);
  }
  .dial-head { text-align: center; display: grid; gap: 14px; }
  .dial-kicker { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; }
  .dial-title { font-size: clamp(48px, 8vw, 128px); }

  .dial {
    position: relative;
    width: min(84vw, 640px);
    aspect-ratio: 1;
    --dial-accent: var(--color-ink);
  }
  .dial__face, .dial__hand-layer { position: absolute; inset: 0; width: 100%; height: 100%; }
  .dial__face { filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.08)); }
  .dial__tint { transition: fill 0.3s var(--ease-cubic); }
  .dial__num { font-family: var(--font-mono); font-size: 11px; fill: #111; opacity: 0.5; }
  .dial__hand-layer { pointer-events: none; z-index: 2; }
  .dial__tip { fill: var(--dial-accent); transition: fill 0.3s var(--ease-cubic); }

  .dial__disc {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 28%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    z-index: 3;
    border-radius: 50%;
    background: var(--color-paper);
    box-shadow: inset 0 0 0 1px var(--color-line), 0 6px 20px rgba(0, 0, 0, 0.08);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .dial__thumb { position: absolute; inset: 10% 10% 22%; width: 80%; height: 68%; object-fit: contain; }
  .dial__mark { font-size: clamp(28px, 5vw, 44px); line-height: 1; }
  .dial__count {
    position: absolute;
    bottom: 13%;
    font-size: clamp(8px, 1.4vw, 11px);
    letter-spacing: 0.04em;
  }
  .dial.has-active .dial__mark { opacity: 0; }

  .dial__label {
    position: absolute;
    z-index: 4;
    transform: translate(-50%, -50%);
    font-size: clamp(13px, 2.6vw, 22px);
    line-height: 0.95;
    text-align: center;
    padding: 6px 8px;
    color: var(--color-ink);
    border-radius: 6px;
    transition: color 0.3s var(--ease-cubic);
  }
  .dial__label:hover, .dial__label:focus-visible, .dial__label[aria-pressed='true'] {
    color: color-mix(in srgb, var(--accent) 70%, #111);
  }

  .dial-pills {
    display: none;
    width: 100vw;
    gap: 8px;
    padding: 4px 16px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .dial-pills::-webkit-scrollbar { display: none; }
  .dial-pills li { flex: none; }
  @media (max-width: 767px), (pointer: coarse) {
    .dial-pills { display: flex; }
  }
</style>

<script>
  import { gsap } from '../../scripts/gsap';
  import { CATEGORIES, productsIn, type CategoryId } from '../../data/products';
  import { emit } from '../../scripts/events';
  import { mouse, lastPointer, pad2, watchVisibility } from '../../scripts/env';

  const dial = document.querySelector<HTMLElement>('[data-dial]')!;
  const hand = dial.querySelector<SVGGElement>('[data-dial-hand]')!;
  const thumb = dial.querySelector<HTMLImageElement>('[data-dial-thumb]')!;
  const count = dial.querySelector<HTMLElement>('[data-dial-count]')!;
  const labels = [...dial.querySelectorAll<HTMLButtonElement>('[data-dial-label]')];
  const ORIGIN = '320 320';

  gsap.set(hand, { svgOrigin: ORIGIN, rotation: 0 });

  let locked: HTMLButtonElement | null = null;

  /* Idle: the hand looks at the cursor. */
  const vis = watchVisibility(dial, undefined, '100px');
  window.addEventListener(
    'pointermove',
    () => {
      if (!vis.visible || locked || !mouse.moved) return;
      const r = dial.getBoundingClientRect();
      const dx = mouse.x - (r.left + r.width / 2);
      const dy = mouse.y - (r.top + r.height / 2);
      const deg = (Math.atan2(dx, -dy) * 180) / Math.PI;
      gsap.to(hand, { rotation: `${deg}_short`, svgOrigin: ORIGIN, duration: 0.3, ease: 'power2.out', overwrite: 'auto' });
    },
    { passive: true },
  );

  const select = (btn: HTMLButtonElement | null) => {
    locked = btn;
    labels.forEach((l) => l.setAttribute('aria-pressed', String(l === btn)));
    dial.classList.toggle('has-active', !!btn);
    if (!btn) {
      dial.style.removeProperty('--dial-tint');
      dial.style.removeProperty('--dial-accent');
      thumb.hidden = true;
      count.textContent = `${pad2(CATEGORIES.length)} CATEGORIES`;
      return;
    }
    const id = btn.dataset.dialLabel as CategoryId;
    const items = productsIn(id);
    dial.style.setProperty('--dial-tint', btn.dataset.accent!);
    dial.style.setProperty('--dial-accent', btn.dataset.accent!);
    thumb.src = items[0]?.images[0] ?? '';
    thumb.hidden = !items.length;
    count.textContent = `${pad2(items.length)} OBJECTS`;
    gsap.to(hand, {
      rotation: `${Number(btn.dataset.deg)}_short`,
      svgOrigin: ORIGIN,
      duration: 0.4,
      ease: 'back.out(3)',
      overwrite: 'auto',
    });
  };

  const goToShop = (id: CategoryId) => emit('hc:filter', { category: id, scroll: true });

  labels.forEach((btn) => {
    btn.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && select(btn));
    btn.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && document.activeElement !== btn && select(null));
    btn.addEventListener('focus', () => select(btn));
    btn.addEventListener('blur', () => !btn.matches(':hover') && select(null));
    btn.addEventListener('click', () => {
      // Touch: the hand moves to the tapped label; the pill row below navigates.
      if (lastPointer === 'touch' || lastPointer === 'pen') select(btn);
      else goToShop(btn.dataset.dialLabel as CategoryId);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-dial-pill]').forEach((pill) =>
    pill.addEventListener('click', () => {
      const btn = labels.find((l) => l.dataset.dialLabel === pill.dataset.dialPill) ?? null;
      select(btn);
      goToShop(pill.dataset.dialPill as CategoryId);
    }),
  );
</script>
