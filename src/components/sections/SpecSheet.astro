---
import { SPEC_SHEET_ID, categoryById, productById } from '../../data/products';
import { specRows } from '../../scripts/spec';
import PillButton from '../ui/PillButton.astro';

const p = productById(SPEC_SHEET_ID)!;
const cat = categoryById(p.category);
const rows = specRows(p);
---

<section class="specs" id="spec" aria-labelledby="spec-title" style={`--accent:${cat.accent};--on-accent:${cat.onAccent}`}>
  <div class="specs__media grain">
    <img src="/images/macro/cap-macro.svg" alt={`Close-up of the ${p.title.toLowerCase()}: embroidered patch and panel seams`} width="1000" height="1400" loading="lazy" decoding="async" />
    <p class="mono specs__media-label">Macro — {p.spec.reference} — ×2.6</p>
  </div>

  <div class="specs__panel">
    <p class="mono specs__maison">{p.maison}</p>
    <h2 id="spec-title" class="serif-i specs__name">Paddock cap</h2>

    <dl class="spec">
      {
        rows.map(([k, v]) => (
          <div class="spec__row">
            <dt>{k}</dt>
            <dd class:list={[k.startsWith('Price') && 'mono']}>{v}</dd>
          </div>
        ))
      }
    </dl>

    <p class="specs__copy" data-scrub>
      Issued in the paddock during a 24-hour race, to people already standing closer to the cars than you were. It has no
      movement, no crown and no service interval. It does, however, offer <em class="specs__key">«&nbsp;full sun protection at six o'clock&nbsp;»</em>, which is more than most dials can claim.
    </p>

    <div class="specs__actions">
      <PillButton data-add={p.id}>Add to cart</PillButton>
      <a href="#authenticity" class="u-grow specs__link">Authenticity notes</a>
    </div>
  </div>
</section>

<style>
  .specs { display: grid; grid-template-columns: 1fr; background: var(--accent); color: var(--on-accent); }
  @media (min-width: 900px) { .specs { grid-template-columns: 1fr 1fr; } }

  .specs__media { position: relative; height: 70svh; overflow: hidden; background: var(--color-paper); }
  @media (min-width: 900px) {
    .specs__media { position: sticky; top: 0; height: 100svh; }
  }
  .specs__media img { width: 100%; height: 100%; object-fit: cover; }
  .specs__media-label {
    position: absolute;
    left: 16px;
    bottom: 16px;
    z-index: 6;
    font-size: 11px;
    text-transform: uppercase;
    color: var(--color-ink);
    background: rgba(241, 241, 241, 0.8);
    padding: 6px 10px;
    border-radius: 9999px;
  }

  .specs__panel {
    padding: clamp(48px, 7vw, 120px) clamp(20px, 5vw, 80px);
    display: flex;
    flex-direction: column;
    gap: 28px;
    --focus: var(--color-ink);
  }
  .specs__maison { font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; }
  .specs__name { font-size: clamp(48px, 5vw, 72px); line-height: 0.95; margin-top: -12px; }
  .specs__copy { font-size: clamp(18px, 1.6vw, 22px); line-height: 1.35; max-width: 34em; }
  .specs__key {
    font-style: normal;
    color: var(--accent);
    background: var(--color-ink);
    padding: 0 0.25em;
    border-radius: 4px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .specs__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }
  .specs__link { font-size: 14px; text-transform: uppercase; letter-spacing: 0.02em; }
</style>
