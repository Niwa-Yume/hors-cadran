---
import { BRAND_NAME, CONTACT, LEGAL } from '../../data/brand';
import PillButton from '../ui/PillButton.astro';
---

<footer class="footer" id="about" aria-labelledby="footer-title">
  <h2 id="footer-title" class="sr-only">About {BRAND_NAME}</h2>
  <div class="footer__top">
    <p class="footer__about">
      {BRAND_NAME} is an independent Geneva reseller of the objects watch houses hand out with, around, and instead of
      watches. Every piece is checked against its paper trail. None of them tell the time.
    </p>

    <div class="footer__cols">
      <nav class="fcol" aria-labelledby="f-watch">
        <h3 id="f-watch" class="display fcol__h">Things to watch</h3>
        <ul>{CONTACT.socials.map((s) => <li><a class="u-grow" href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
      </nav>
      <nav class="fcol" aria-labelledby="f-boring">
        <h3 id="f-boring" class="display fcol__h">Boring stuff</h3>
        <ul>
          <li><a class="u-grow" href="#shipping">Shipping</a></li>
          <li><a class="u-grow" href="#returns">Returns</a></li>
          <li><a class="u-grow" href="#terms">Terms</a></li>
          <li><a class="u-grow" href="#privacy">Privacy</a></li>
        </ul>
      </nav>
      <nav class="fcol" aria-labelledby="f-house">
        <h3 id="f-house" class="display fcol__h">The house</h3>
        <ul>
          <li><a class="u-grow" href="#about">About</a></li>
          <li id="authenticity"><a class="u-grow" href="#spec">Authenticity</a></li>
          <li><a class="u-grow" href={`mailto:${CONTACT.email}`}>Contact</a></li>
        </ul>
        <ul class="mono fcol__contact">
          <li><span>S:</span> {CONTACT.socials.map((s) => s.label).join(' / ')}</li>
          <li><span>E:</span> <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
          <li><span>L:</span> {CONTACT.location}</li>
        </ul>
      </nav>
      <div class="fcol">
        <h3 class="display fcol__h" id="f-alert">Drop alert</h3>
        <form class="footer__form" data-alert-form novalidate aria-labelledby="f-alert">
          <label class="sr-only" for="footer-email">Email address</label>
          <input id="footer-email" type="email" required autocomplete="email" placeholder="Email" />
          <PillButton type="submit" size="sm">Notify me</PillButton>
        </form>
      </div>
    </div>

    <div class="footer__bezel" data-footer-bezel aria-hidden="true">
      <div class="footer__bezel-fallback"></div>
    </div>
  </div>

  <p class="mono footer__legal">{LEGAL}</p>
  <p class="gothic footer__wordmark" aria-hidden="true">{BRAND_NAME}</p>
</footer>

<style>
  .footer { background: var(--color-paper); padding: clamp(64px, 8vw, 120px) clamp(16px, 3vw, 40px) 0; overflow: hidden; --focus: var(--color-seconds-red); }
  .footer__top {
    display: grid;
    gap: 48px;
    grid-template-columns: 1fr;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .footer__top { grid-template-columns: 1fr minmax(260px, 340px); grid-template-areas: 'about bezel' 'cols bezel'; }
    .footer__about { grid-area: about; }
    .footer__cols { grid-area: cols; }
    .footer__bezel { grid-area: bezel; }
  }
  .footer__about { max-width: 38em; font-size: 17px; }
  .footer__cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 24px; }
  @media (min-width: 768px) { .footer__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .fcol { display: grid; align-content: start; gap: 14px; font-size: 15px; }
  .fcol ul { display: grid; gap: 6px; }
  .fcol__h { font-size: 12px; font-stretch: 62%; letter-spacing: 0.04em; }
  .fcol__contact { margin-top: 12px; font-size: 11px; gap: 4px !important; }
  .fcol__contact span { opacity: 0.55; }
  .footer__form { display: grid; gap: 12px; }
  .footer__form input { background: transparent; border: 0; border-bottom: 1px solid var(--color-ink); padding: 10px 0; font-size: 15px; }
  .footer__form input:focus-visible { outline: none; border-bottom-width: 2px; }
  .footer__form .pill { justify-self: start; }

  .footer__bezel { position: relative; width: min(340px, 70vw); aspect-ratio: 1; justify-self: center; }
  .footer__bezel :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; }
  .footer__bezel-fallback {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: conic-gradient(from 200deg, #8c8c8c, #f4f4f4, #a6a6a6, #7a7a7a, #e6e6e6, #8c8c8c);
    -webkit-mask: radial-gradient(circle, transparent 57%, #000 58%);
    mask: radial-gradient(circle, transparent 57%, #000 58%);
    transition: opacity 0.6s var(--ease-cubic);
  }
  .footer__bezel:global(.is-ready) .footer__bezel-fallback { opacity: 0; }

  .footer__legal { margin-top: clamp(48px, 6vw, 96px); font-size: 11px; max-width: 70em; opacity: 0.7; }
  .footer__wordmark {
    font-size: clamp(64px, 18vw, 380px);
    line-height: 0.8;
    white-space: nowrap;
    margin: clamp(16px, 3vw, 40px) 0 -0.24em;
    text-align: center;
    letter-spacing: -0.01em;
  }
</style>

<script>
  import { isDesktop, reduced, webglAvailable, whenIdle } from '../../scripts/env';

  /* Chrome bezel: its own light canvas, created only when the footer comes into view. */
  const host = document.querySelector<HTMLElement>('[data-footer-bezel]');
  if (host && webglAvailable() && isDesktop()) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        whenIdle(async () => {
          const { initFooterScene } = await import('../../scripts/three/footer-scene');
          initFooterScene(host, reduced);
        });
      },
      { rootMargin: '300px' },
    );
    io.observe(host);
  }
</script>
