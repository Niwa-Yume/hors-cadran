---
import Marquee from '../ui/Marquee.astro';

const zones = [
  { name: 'Geneva', service: 'Hand delivery, same day', cities: ['Rive gauche', 'Rive droite'] },
  { name: 'Switzerland', service: '48h', cities: ['Zurich', 'Basel', 'Lausanne', 'Le Brassus'] },
  { name: 'Europe', service: 'Express 2–4 days', cities: ['Paris', 'London', 'Milan', 'Munich'] },
  { name: 'Asia', service: 'Express 3–5 days', cities: ['Hong Kong', 'Singapore', 'Tokyo', 'Seoul'] },
  { name: 'Middle East', service: 'Express 3–5 days', cities: ['Dubai', 'Doha', 'Riyadh'] },
];
---

<section class="ships grain" id="shipping" aria-labelledby="ships-title">
  <h2 id="ships-title" class="sr-only">Ships worldwide</h2>
  <Marquee text="Ships worldwide — " size="md" duration={28} />

  <div class="ships__zones">
    {
      zones.map((z) => (
        <div class="zone">
          <h3 class="display zone__name" data-fade-in>{z.name}</h3>
          <ul class="zone__cities">
            {z.cities.map((c) => (
              <li class="city">
                <p class="display city__name" data-fade-in>{c}</p>
                <p class="city__pill" data-fade-pill>{z.service}</p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .ships {
    background: var(--color-black);
    color: #fff;
    padding: clamp(48px, 6vw, 96px) 0 clamp(80px, 10vw, 160px);
    --focus: var(--color-lume-lime);
  }
  .ships__zones { max-width: 980px; margin: clamp(48px, 7vw, 120px) auto 0; padding-inline: 16px; display: grid; gap: clamp(56px, 8vw, 120px); }
  .zone { display: grid; gap: clamp(20px, 3vw, 36px); }
  .zone__name { text-align: center; font-size: clamp(48px, 8vw, 128px); color: #fff; }
  .zone__cities { display: grid; grid-template-columns: 1fr 1fr; gap: 24px var(--gutter); }
  .city { display: grid; gap: 10px; }
  .city__name { font-size: clamp(20px, 2.2vw, 30px); color: #fff; }
  .city__pill {
    width: 100%;
    padding: 14px 16px;
    border-radius: var(--radius-zine);
    background: rgba(255, 255, 255, 0.96);
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
</style>

<script>
  import { gsap } from '../../scripts/gsap';
  import { reduced } from '../../scripts/env';

  /* Headings and pills fade from #9A9A9A to white as they enter. */
  if (!reduced) {
    document.querySelectorAll<HTMLElement>('[data-fade-in]').forEach((el) =>
      gsap.fromTo(el, { color: '#9A9A9A' }, { color: '#FFFFFF', ease: 'none', scrollTrigger: { trigger: el, start: 'top 95%', end: 'top 60%', scrub: true } }),
    );
    document.querySelectorAll<HTMLElement>('[data-fade-pill]').forEach((el) =>
      gsap.fromTo(
        el,
        { backgroundColor: '#9A9A9A' },
        { backgroundColor: 'rgba(255,255,255,0.96)', ease: 'none', scrollTrigger: { trigger: el, start: 'top 95%', end: 'top 65%', scrub: true } },
      ),
    );
  }
</script>
